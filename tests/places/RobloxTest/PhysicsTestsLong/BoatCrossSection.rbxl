	<Item class="TestService" referent="RBX0000003C">
		<Properties>
			<bool name="AutoRuns">true</bool>
			<string name="Description"></string>
			<bool name="Is30FpsThrottleEnabled">true</bool>
			<bool name="IsPhysicsEnvironmentalThrottled">true</bool>
			<bool name="IsSleepAllowed">true</bool>
			<string name="Name">TestService</string>
			<double name="Timeout">90</double>
		</Properties>
		<Item class="Script" referent="RBX0000003D">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source"><![CDATA[if game.Workspace:ExperimentalSolverIsEnabled() then
	RBX_CHECK_MESSAGE(true, "Using PGS solver - TEST SKIPPED")
else
	-- race test; phys. fidelity long-form test to check viscosity doesn't cause major issues when applied to a simple "motorboat"
	-- we just make sure that we eventually cross to the other edge of the pool in a "decent" amount of time
	local topOne = workspace.Column1.bodyTop
	local topTwo = workspace.Column2.bodyTop
	
	local firstPart = nil
	
	local magicHeight = 130
	
	while true do
		wait()
		if (topOne.CFrame.p.Y < magicHeight and topTwo.CFrame.p.Y < magicHeight) then
			break
		end
	
		if not firstPart and topOne.CFrame.p.Y < magicHeight then firstPart = topOne end
		if not firstPart and topTwo.CFrame.p.Y < magicHeight then firstPart = topTwo end
	end
	
	game:GetService("TestService"):Check(firstPart == topTwo, "cross-section boat test")
end
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>