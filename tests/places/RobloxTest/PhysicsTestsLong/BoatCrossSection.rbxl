		<Item class="Script" referent="RBX00000003">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">PartsOnWaterTest</string>
				<ProtectedString name="Source"><![CDATA[local numParts = 300
local poolSize = 1200 -- edge length
local dropHeight = 150 -- drop everything from 150 studs up

for i = 1, numParts do
	local newPart = Instance.new("Part")
	newPart.Size = newPart.Size * (math.random()*10 + .5)
	newPart.CFrame = CFrame.Angles(math.random()*math.pi*2, math.random()*math.pi*2, math.random()*math.pi*2)
	newPart.CFrame = newPart.CFrame + poolSize * Vector3.new(math.random()-.5, 0, math.random()-.5) + Vector3.new(0, dropHeight, 0)
	newPart.Parent = game.Workspace
end
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000004">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BigPartsOnWaterTest</string>
				<ProtectedString name="Source"><![CDATA[local numParts = 30
local poolSize = 1200 -- edge length
local dropHeight = 200 -- drop everything from 200 studs up

for i = 1, numParts do
	local newPart = Instance.new("Part")
	newPart.Size = newPart.Size * (math.random()*5 + 30)
	newPart.CFrame = CFrame.Angles(math.random()*math.pi*2, math.random()*math.pi*2, math.random()*math.pi*2)
	newPart.CFrame = newPart.CFrame + poolSize * Vector3.new(math.random()-.5, 0, math.random()-.5) + Vector3.new(0, dropHeight, 0)
	newPart.Parent = game.Workspace
end
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000005">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">PartsUnderWaterTest</string>
				<ProtectedString name="Source"><![CDATA[local numParts = 300
local poolSize = 1200 -- edge length
local dropHeight = 60 -- start from in water

local partMaterial = "CorrodedMetal"
--local partMaterial = "Wood"

for i = 1, numParts do
	local newPart = Instance.new("Part")
	newPart.Size = newPart.Size * (math.random()*3 + .5)
	newPart.CFrame = CFrame.Angles(math.random()*math.pi*2, math.random()*math.pi*2, math.random()*math.pi*2)
	newPart.CFrame = newPart.CFrame + poolSize * Vector3.new(math.random()-.5, 0, math.random()-.5) + Vector3.new(0, dropHeight, 0)

	newPart.Material = partMaterial

	newPart.Parent = game.Workspace
end
]]></ProtectedString>
			</Properties>
		</Item>
